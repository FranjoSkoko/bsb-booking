# Na Replitu ovo NE upisujte u datoteku – dodajte u Tools → Secrets.
DATABASE_URL=postgresql://...        # Replit ga postavlja sam kad dodate PostgreSQL bazu
ADMIN_PASSWORD=                      # lozinka za /admin
SESSION_SECRET=                      # dugi nasumični niz znakova
# Mailovi: ILI Google skripta (Railway blokira SMTP na besplatnom/Hobby planu) ...
MAIL_RELAY_URL=                      # URL web-aplikacije iz gmail-skripta.gs (završava s /exec)
MAIL_RELAY_KEY=                      # isti ključ kao KLJUC u skripti
# ... ILI SMTP (Gmail App password)
# SMTP_USER=barbaraskokobeauty@gmail.com
# SMTP_PASS=                         # Gmail "App password" (16 znakova), NE obična lozinka
# Neobavezno:
# PUBLIC_URL=https://bsb-booking.replit.app   # adresa objavljene aplikacije (za linkove u emailovima)
# ADMIN_EMAIL=barbaraskokobeauty@gmail.com     # kamo stižu obavijesti o novim rezervacijama
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# MAIL_FROM=Barbara Skoko Beauty <barbaraskokobeauty@gmail.com>
# CRON_SECRET=                                 # za vanjski cron na /api/cron?key=...
